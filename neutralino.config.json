{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "js.amp.manager",
  "applicationName": "AMP-Manager",
  "applicationIcon": "resources/icons/ampManager256.png",
  "version": "1.0.0",
  "defaultMode": "window",
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "storageLocation": "app",
  "dataLocation": "app",
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": true,
    "writeToLogFile": true
  },
  "nativeAllowList": [
    "os.execCommand",
    "os.open",
    "os.spawnProcess",
    "os.updateSpawnedProcess",
    "filesystem.readFile",
    "filesystem.writeFile",
    "filesystem.copyFile",
    "filesystem.removeFile",
    "filesystem.readDirectory",
    "filesystem.getStats",
    "filesystem.createDirectory",
    "filesystem.remove",
    "filesystem.getAbsolutePath",
    "events.on",
    "events.off",
    "events.dispatch",
    "window.show",
    "window.setDraggableRegion",
    "window.beginDrag",
    "window.minimize",
    "window.unmaximize",
    "window.close",
    "window.isMaximized",
    "app.exit"
  ],
  "application": {
    "singleInstance": true
  },
  "modes": {
    "window": {
      "hidden": false,
      "skipTaskbar": false,
      "title": "AMP Manager",
      "useLogicalPixels": true,
      "width": 1280,
      "height": 800,
      "minWidth": 1240,
      "minHeight": 760,
      "center": true,
      "fullScreen": false,
      "alwaysOnTop": false,
      "icon": "/resources/icons/appIcon.png",
      "enableInspector": false,
      "borderless": true,
      "transparent": true,
      "minimize": true,
      "maximizeOnStart": false,
      "resizable": true,
      "useSavedState": false,
      "exitProcessOnClose": false
    }
  },
  "cli": {
    "binaryName": "amp-manager",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.5.0",
    "clientVersion": "6.5.0"
  }
}