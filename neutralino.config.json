{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "js.amp.manager",
  "applicationName": "AMP Manager",
  "author": "Nuno Luciano",
  "description": "Local Web Development, Docker-based stack simplified",
  "copyright": "Copyright © 2026 Nuno Luciano - AMP Manager",
  "applicationIcon": "resources/icons/trayIcon.png",
  "version": "1.0.0",
  "defaultMode": "window",
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "storageLocation": "app",
  "dataLocation": "app",
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": false,
    "writeToLogFile": false
  },
  "nativeAllowList": [
    "app.*",
    "os.*",
    "window.*",
    "debug.*",
    "fs.*",
    "storage.*",
    "nativeCalls.*",
    "extensions.*",
    "events.*"
  ],
  "application": {
    "singleInstance": true
  },
  "modes": {
    "window": {
      "hidden": false,
      "skipTaskbar": false,
      "title": "AMP Manager",
      "useLogicalPixels": true,
      "width": 1270,
      "height": 800,
      "minWidth": 1270,
      "minHeight": 800,
      "center": true,
      "fullScreen": false,
      "alwaysOnTop": false,
      "icon": "/resources/icons/appIcon.png",
      "borderless": true,
      "transparent": true,
      "minimize": true,
      "maximizeOnStart": false,
      "resizable": true,
      "useSavedState": false,
      "exitProcessOnClose": true,
      "enableInspector": false
    }
  },
  "cli": {
    "binaryName": "amp-manager",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.5.0",
    "clientVersion": "6.5.0"
  }
}